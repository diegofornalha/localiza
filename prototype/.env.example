# Chatbot Localiza - Configuração

# OpenAI API Key (obrigatório para usar GPT)
OPENAI_API_KEY=sk-your-key-here

# Modelo principal (opcional, default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Modelo de fallback (opcional, default: gpt-3.5-turbo)
LLM_FALLBACK=gpt-3.5-turbo

# Servidor
HOST=0.0.0.0
PORT=8000
